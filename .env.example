# ─── Supabase ────────────────────────────────────────────────────────────────
# Get from: supabase.com → Project Settings → API
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── LLM Providers ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional providers
OPENROUTER_API_KEY=sk-or-...
# Ollama Cloud (ollama.com) — OpenAI-compatible API, models: gemma4:31b / gemma3:12b / gemma3:4b
OLLAMA_API_KEY=ollama-...

# ─── Multi-tenancy ───────────────────────────────────────────────────────────
# UUID of the default tenant used in dev/demo (matches supabase/seed.sql)
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# ─── Pipeline thresholds ─────────────────────────────────────────────────────
# Confidence Gate: score below this triggers human handoff (0.0–1.0)
CONFIDENCE_THRESHOLD=0.70

# Debouncing window per lead before processing (ADR-06)
DEBOUNCE_MIN_SECONDS=30
DEBOUNCE_MAX_SECONDS=90

# ─── LLM routing ─────────────────────────────────────────────────────────────
# Proveedor preferido: openrouter | ollama | anthropic | openai
# Demo priority: openrouter (Claude via gateway) → ollama (Gemma cloud) → anthropic → openai
PREFERRED_LLM_PROVIDER=openrouter

# ─── App ─────────────────────────────────────────────────────────────────────
ENV=dev
LOG_LEVEL=INFO
