# ─── Supabase ────────────────────────────────────────────────────────────────
# Obten estas keys en: supabase.com → Project Settings → API
# Nota: el acceso a datos usa REST/HTTPS (supabase-py), no conexión directa a Postgres.
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── LLM Providers ───────────────────────────────────────────────────────────
# Proveedor recomendado para el demo: OpenRouter (más barato, acceso a múltiples modelos)
OPENROUTER_API_KEY=sk-or-...

# Ollama Cloud (ollama.com) — OpenAI-compatible, modelos: gemma4:31b / gemma3:12b / gemma3:4b
OLLAMA_API_KEY=ollama-...

# Proveedores opcionales (fallback)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ─── Multi-tenancy ───────────────────────────────────────────────────────────
# UUID del tenant demo (debe existir en la tabla tenants — ver supabase/seed.sql)
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# ─── Pipeline thresholds ─────────────────────────────────────────────────────
# Confidence Gate: score por debajo de este valor dispara handoff a humano (0.0–1.0)
CONFIDENCE_THRESHOLD=0.70

# Ventana de debouncing por lead antes de procesar la respuesta (ADR-06)
DEBOUNCE_MIN_SECONDS=30
DEBOUNCE_MAX_SECONDS=90

# ─── LLM routing ─────────────────────────────────────────────────────────────
# Prioridad demo: openrouter → ollama → anthropic → openai
PREFERRED_LLM_PROVIDER=openrouter

# ─── App ─────────────────────────────────────────────────────────────────────
ENV=dev
LOG_LEVEL=INFO
